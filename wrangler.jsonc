/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-analytics",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "analytics.fayazahmed.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "TRACKER_ORIGIN": "https://analytics.fayazahmed.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-analytics-db",
      "database_id": "22cbc435-c93f-4f2d-b3da-2dec61736110",
      // Preserve the original local D1 identity that contains demo data.
      "preview_database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_VISITORS",
        "class_name": "LiveVisitors"
      }
    ]
  },
  "exports": {
    "LiveVisitors": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    // Runs once daily at 00:10 UTC — rolls up the previous UTC day's raw
    // rows into the daily_* tables (see src/lib/aggregate.ts).
    "crons": ["10 0 * * *"]
  }
}
